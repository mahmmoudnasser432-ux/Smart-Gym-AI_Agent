# Node Environment
NODE_ENV=production

# Server Configuration
PORT=5000

# Database Configuration (SQL Server)
DB_SERVER=your-sql-server.database.windows.net
DB_NAME=SmartGym
DB_USER=your_sql_admin_user
DB_PASSWORD=your_sql_password
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_CERT=false

# Authentication
JWT_SECRET=replace_with_a_long_random_secret_At_least_32_characters
INTERNAL_SECRET=replace_with_another_secret_for_internal_api_calls

# AI Agent Service (External)
AI_AGENT_URL=https://your-ai-agent-service.azurewebsites.net
OPENAI_API_KEY=your_openai_api_key_for_fallback  # Optional: Used if AI agent is unavailable
AI_MODEL=gpt-4.1-mini  # Optional: Default model for OpenAI fallback

# Email Configuration (SMTP)
SMTP_HOST=your_smtp_host  # Optional: Email service runs in MOCK mode if not configured
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# CORS Configuration
CORS_ORIGIN=https://smart-gym-ai-agent.vercel.app  # Frontend URL
