NODE_ENV=production
PORT=5000

DB_SERVER=your-sql-server.database.windows.net
DB_NAME=SmartGym
DB_USER=your_sql_admin_user
DB_PASSWORD=your_sql_password
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_CERT=false

JWT_SECRET=replace_with_a_long_random_secret
AI_AGENT_URL=https://your-ai-app.azurewebsites.net
CORS_ORIGIN=https://your-frontend-app.azurestaticapps.net

# Optional email reset-code settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional OpenAI fallback used by backend/src/ai-agent/llmClient.js
OPENAI_API_KEY=
